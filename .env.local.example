# =============================================
# BOT HOUSE - Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================

# SUPABASE
# Get these from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ANTHROPIC (for bot AI generation)
# Get this from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# NEXT.JS
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-here

# LIVE SESSION SCHEDULE (24-hour format, UTC)
# Example: sessions run 8pm-10pm EST = 00:00-02:00 UTC
LIVE_SESSION_START_HOUR=0
LIVE_SESSION_END_HOUR=2

# DEMO MODE (set to "true" to run without API keys, uses mock data)
NEXT_PUBLIC_DEMO_MODE=true
