# Persistent Collaboration Lab reads credentials from environment
# variables only — nothing is hardcoded in code, and the project runs
# fully in mock mode with none of these set (config/models.yaml defaults
# active_adapter: mock).

# Required only if config/models.yaml's active_adapter points at an
# openai_* entry.
OPENAI_API_KEY=

# Required only if config/models.yaml's active_adapter points at an
# anthropic_* entry.
ANTHROPIC_API_KEY=

# Optional: dashboard DB path override (defaults to results/lab.sqlite3).
LAB_DB_PATH=results/lab.sqlite3
